# Copy this file to .env and fill it in.

# A long random password. Put the same value in the phone app's Settings.
REELNOTES_TOKEN=change-me-to-a-long-random-string
REELNOTES_PORT=8787

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model name; "gemini-flash-latest" always points at the current Flash model.
GEMINI_MODEL=gemini-flash-latest

# Claude Code CLI (logged in with your Claude Pro account). Leave CLAUDE_MODEL empty for your default.
CLAUDE_CLI=claude
CLAUDE_MODEL=

# Speech-to-text for the Claude option. auto = use the NVIDIA GPU, fall back to CPU.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto

# Only if Instagram downloads fail (see README "Instagram login"):
# YTDLP_COOKIES_FILE=C:\path\to\instagram_cookies.txt
# YTDLP_COOKIES_BROWSER=firefox
